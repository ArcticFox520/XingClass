<?xml version="1.0" encoding="utf-8"?>
<!--
  XingClass stores credentials, session cookies and the course cache in internal storage.
  Backups are disabled entirely in the manifest; these rules are a second layer of defence
  in case that flag is ever changed by mistake.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
